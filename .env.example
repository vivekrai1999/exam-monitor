# ---------------------------------------------------------------------------
# Rajasthan Exam Notification Monitoring & Publishing
#
# Copy this file to .env and fill in your values for local testing.
# For GitHub Actions deployment, configure these as Repository Secrets.
# ---------------------------------------------------------------------------

# Supabase Configuration (Required)
# Service role key is required to manage advisory locks, write to exam_notices, and claim outbox jobs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram Bot API Token (Required for Telegram alerts)
# Generated from @BotFather (e.g. for @pyqboxbot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Firebase Cloud Messaging (FCM HTTP v1) for App Push Notifications
# Set to local path (e.g. ./secrets/firebase-service-account.json)
# OR paste the raw minified JSON string directly into this variable.
FCM_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# Google Gemini AI Enrichment (Optional)
# If provided, generates structured bilingual summaries, key points, and vacancy counts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# Local Worker Poll Interval (Optional override, default adapts dynamically to IST hours)
# POLL_INTERVAL_SECONDS=120
